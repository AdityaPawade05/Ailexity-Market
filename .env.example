# PostgreSQL connection string
# Local development:
DATABASE_URL="postgresql://postgres:password@localhost:5432/ailexity_market?schema=public"
# Hostinger VPS / AWS RDS (production):
# DATABASE_URL="postgresql://USER:PASSWORD@your-db-host:5432/ailexity_market?schema=public&sslmode=require&connection_limit=10"

# DIRECT_URL bypasses connection pooler — required for prisma migrate
# Local development: same as DATABASE_URL
DIRECT_URL="postgresql://postgres:password@localhost:5432/ailexity_market?schema=public"
# Production: direct DB endpoint (not a pooler/proxy)
# DIRECT_URL="postgresql://USER:PASSWORD@your-db-host:5432/ailexity_market?schema=public&sslmode=require"

JWT_SECRET="your-secret-key-change-in-production"

# Encrypts third-party bot tokens (Discord/Telegram) at rest. Generate with:
# openssl rand -hex 32
ENCRYPTION_KEY="your-32-byte-random-key-change-in-production"

GEMINI_API_KEY="your-gemini-api-key"
# Optional fallback used only if all Gemini models fail
# OPENAI_API_KEY="your-openai-api-key"

# Platform commission rate taken from each sale (0.10 = 10%). Optional, defaults to 0.10.
# AILEXITY_COMMISSION_RATE="0.10"

# Public base URL of the app (used for email links and OAuth redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Discord OAuth (https://discord.com/developers/applications) — used for the
# platform-wide "Connect Discord" flow.
# To get the secret: open your application → OAuth2 tab → "Reset Secret" →
# copy the value shown (it is displayed only once).
# Also add the redirect there: <NEXT_PUBLIC_APP_URL>/api/integrations/discord/callback
# The app boots fine without this — Discord linking is simply disabled
# (a warning is printed at startup).
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# Telegram Login Widget (https://core.telegram.org/widgets/login) — a single
# platform-wide bot (distinct from each community's own bot) used only for the
# "Connect Telegram" account-linking flow. Create it with @BotFather (/newbot),
# then run /setdomain and point it at NEXT_PUBLIC_APP_URL's domain.
# TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="your_bot_username"

# ── Email (verification, receipts, refunds, announcements) ──────────────────
# Unset in dev → falls back to a throwaway Ethereal test inbox (preview link
# printed to the console). For production use a transactional provider, not a
# personal Gmail (Gmail has ~500/day limits and poor deliverability for
# automated mail). Any SMTP provider works — ready-made settings:
#
# Resend (resend.com — verify your domain, create an API key):
#   SMTP_HOST="smtp.resend.com"  SMTP_PORT="465"  SMTP_SECURE="true"
#   SMTP_USER="resend"           SMTP_PASS="re_your_api_key"
#   SMTP_FROM="noreply@your-domain.com"
#
# Brevo (brevo.com → SMTP & API → SMTP):
#   SMTP_HOST="smtp-relay.brevo.com"  SMTP_PORT="587"  SMTP_SECURE="false"
#   SMTP_USER="your-brevo-login"      SMTP_PASS="your-brevo-smtp-key"
#   SMTP_FROM="noreply@your-domain.com"
#
# Amazon SES (verify domain, create SMTP credentials in the SES console):
#   SMTP_HOST="email-smtp.<region>.amazonaws.com"  SMTP_PORT="587"  SMTP_SECURE="false"
#   SMTP_USER="your-ses-smtp-username"             SMTP_PASS="your-ses-smtp-password"
#   SMTP_FROM="noreply@your-domain.com"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
# Visible From address. REQUIRED for API-key-style providers (Resend/Brevo/SES)
# where SMTP_USER isn't an email address; optional for Gmail-style setups
# (falls back to SMTP_USER). Must be on a domain the provider has verified.
# SMTP_FROM="noreply@your-domain.com"
